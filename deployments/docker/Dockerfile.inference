# Contenedor batch del modelo predictivo: reentrena y reconstruye la BD.
# Construir desde la raíz del repositorio:
#   docker build -f deployments/docker/Dockerfile.inference -t sanghelios-inference .
#   docker run --rm -v ./data:/app/data -v ./models:/app/models sanghelios-inference
FROM python:3.13-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project

COPY . .

# Reentrena el XGBoost, exporta models/predictive/escasez_model.pkl
# y escribe data/sanghelios.db (montar ambos volúmenes para persistir).
CMD ["uv", "run", "--no-sync", "python", "scripts/build_db_and_model.py"]
