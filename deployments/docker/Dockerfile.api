# Contenedor de la API (FastAPI + frontend + asistente de campañas).
# Construir desde la raíz del repositorio:
#   docker build -f deployments/docker/Dockerfile.api -t sanghelios-api .
#   docker run -p 8000:8000 --env-file .env sanghelios-api
FROM python:3.13-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# Dependencias primero para aprovechar la caché de capas.
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project

COPY . .

EXPOSE 8000
CMD ["uv", "run", "--no-sync", "uvicorn", "src.app:app", "--host", "0.0.0.0", "--port", "8000"]
